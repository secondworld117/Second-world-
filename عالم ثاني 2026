<!DOCTYPE html>
<html lang="ar" dir="rtl" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="pageTitle">عالم ثاني 2026 | Second World</title>
    <meta name="description" content="عالم ثاني - البوابة الرقمية المتقدمة لعوالم المستقبل والتقنية وتصميمات الويب الحديثة.">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;700;900&family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        /* ==========================================
           ملف التصميم المدمج (CSS)
           ================================---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo', 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: #030712;
            color: #f3f4f6;
            overflow-x: hidden;
            transition: background 0.3s ease;
        }

        .cyber-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
        }

        /* Navbar */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 6%;
            background: rgba(3, 7, 18, 0.9);
            backdrop-filter: blur(15px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(0, 243, 255, 0.15);
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            color: #fff;
        }

        .logo .dot {
            color: #00f3ff;
        }

        .nav-links {
            display: flex;
            gap: 25px;
        }

        .nav-links a {
            color: #9ca3af;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #00f3ff;
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.6);
        }

        .nav-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .lang-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        .lang-btn:hover {
            background: #00f3ff;
            color: #030712;
            border-color: #00f3ff;
        }

        .cta-btn {
            background: #00f3ff;
            color: #030712;
            padding: 8px 20px;
            border-radius: 20px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .cta-btn:hover {
            box-shadow: 0 0 15px #00f3ff;
        }

        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: radial-gradient(circle at center, rgba(14, 25, 48, 0.7) 0%, rgba(3, 7, 18, 1) 80%);
            padding: 0 20px;
        }

        .badge {
            display: inline-block;
            padding: 6px 16px;
            background: rgba(0, 243, 255, 0.1);
            color: #00f3ff;
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 20px;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 64px;
            font-weight: 900;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #ffffff 30%, #00f3ff 70%, #9333ea 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 18px;
            color: #9ca3af;
            max-width: 600px;
            margin: 0 auto 35px auto;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .primary-btn {
            background: linear-gradient(135deg, #00f3ff, #2563eb);
            color: #fff;
            padding: 12px 28px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.4);
        }

        .secondary-btn {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 12px 28px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
        }

        /* Posts Section */
        .posts-section {
            padding: 100px 8%;
            text-align: center;
        }

        .posts-section h2 {
            font-size: 36px;
            margin-bottom: 10px;
        }

        .section-subtitle {
            color: #9ca3af;
            margin-bottom: 50px;
        }

        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .post-card {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(0, 243, 255, 0.2);
            border-radius: 16px;
            overflow: hidden;
            text-align: right;
            transition: 0.3s;
        }

        .post-card:hover {
            transform: translateY(-8px);
            border-color: #00f3ff;
            box-shadow: 0 10px 30px rgba(0, 243, 255, 0.2);
        }

        .post-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .post-content {
            padding: 20px;
        }

        .post-date {
            font-size: 12px;
            color: #00f3ff;
            margin-bottom: 8px;
            display: block;
        }

        .post-content h3 {
            font-size: 20px;
            margin-bottom: 10px;
            color: #fff;
        }

        .post-content p {
            color: #9ca3af;
            font-size: 14px;
        }

        /* Control Panel */
        .control-section {
            padding: 80px 8%;
            background: rgba(11, 19, 43, 0.4);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .control-container {
            max-width: 900px;
            margin: 0 auto;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(0, 243, 255, 0.3);
            padding: 40px;
            border-radius: 20px;
        }

        .control-container h2 {
            text-align: center;
            margin-bottom: 10px;
        }

        .control-container > p {
            text-align: center;
            color: #9ca3af;
            margin-bottom: 30px;
        }

        .control-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .ctrl-box h3 {
            color: #00f3ff;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .ctrl-box input, .ctrl-box textarea {
            width: 100%;
            background: #030712;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 12px;
            border-radius: 8px;
            color: #fff;
            margin-bottom: 12px;
            outline: none;
        }

        .ctrl-box textarea {
            height: 90px;
            resize: none;
        }

        .ctrl-btn {
            background: #00f3ff;
            color: #030712;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: 0.3s;
        }

        .ctrl-btn:hover {
            background: #2563eb;
            color: #fff;
        }

        /* Contact Section */
        .contact-section {
            padding: 80px 8%;
            text-align: center;
        }

        .contact-section h2 {
            margin-bottom: 40px;
        }

        .contact-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .contact-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 30px;
            border-radius: 16px;
            text-decoration: none;
            color: #fff;
            transition: 0.3s;
        }

        .contact-card:hover {
            border-color: #00f3ff;
            transform: translateY(-5px);
        }

        .contact-card span {
            font-size: 32px;
            display: block;
            margin-bottom: 15px;
        }

        .contact-card h3 {
            color: #00f3ff;
            margin-bottom: 8px;
            font-size: 18px;
        }

        .contact-card p {
            color: #9ca3af;
            font-size: 14px;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: #6b7280;
            font-size: 14px;
        }
    </style>
</head>
<body id="bodyBg">

    <!-- خلفية شبكية مستقبلية متحركة -->
    <div class="cyber-grid"></div>

    <!-- شريط التنقل العلوي -->
    <header class="navbar">
        <div class="logo">
            <span id="logoText">عالم ثانٍ 2026</span> <span class="dot">.</span>
        </div>
        <nav class="nav-links">
            <a href="#hero" data-i18n="navHome">الرئيسية</a>
            <a href="#posts" data-i18n="navPosts">المنشورات</a>
            <a href="#controlPanel" data-i18n="navControl">لوحة التحكم</a>
            <a href="#contact" data-i18n="navContact">تواصل معنا</a>
        </nav>
        <div class="nav-actions">
            <button class="lang-btn" onclick="toggleLanguage()">🌐 <span id="langLabel">EN</span></button>
            <a href="https://wa.me/967773546637" target="_blank" class="cta-btn" data-i18n="navStart">ابدأ الآن</a>
        </div>
    </header>

    <!-- القسم الرئيسي (Hero) -->
    <section id="hero" class="hero">
        <div class="hero-content">
            <span class="badge" data-i18n="heroBadge">إصدار 2026 - مستقبل الابتكار الرقمي</span>
            <h1 id="mainTitle">عالم ثانٍ 2026</h1>
            <p id="mainSubtitle" data-i18n="heroDesc">بوابة نحو فضاءات افتراضية وتقنيات ذكية تتخطى حدود الخيال المألوف.</p>
            <div class="hero-buttons">
                <a href="#posts" class="primary-btn" data-i18n="btnExplore">استكشف المنشورات</a>
                <a href="https://pin.it/6uFYoGdKw" target="_blank" class="secondary-btn" data-i18n="btnPin">معرض Pinterest</a>
            </div>
        </div>
    </section>

    <!-- قسم المنشورات الديناميكية -->
    <section id="posts" class="posts-section">
        <h2 data-i18n="postsTitle">أحدث المنشورات والإبداعات</h2>
        <p class="section-subtitle" data-i18n="postsSub">محتوى متجدد، تصاميم، ورؤى مستقبلية</p>
        
        <div id="postsGrid" class="posts-grid">
            <div class="post-card">
                <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop" alt="افتراضي">
                <div class="post-content">
                    <span class="post-date">2026-03-30</span>
                    <h3>انطلاق عالم ثاني 2026</h3>
                    <p>بداية رحلة استثنائية لدمج الخيال بالواقع الافتراضي الحديث.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- لوحة التحكم المصغرة (للتحكم المباشر) -->
    <section id="controlPanel" class="control-section">
        <div class="control-container">
            <h2 data-i18n="ctrlTitle">🎛️ لوحة التحكم السريعة</h2>
            <p data-i18n="ctrlSub">أضف منشوراتك، عدّل اسم الموقع، أو غير خلفية الموقع بلمسة واحدة!</p>
            
            <div class="control-grid">
                <div class="ctrl-box">
                    <h3 data-i18n="ctrlAddPost">إضافة منشور / تصميم جديد</h3>
                    <input type="text" id="postTitleInput" placeholder="عنوان المنشور...">
                    <textarea id="postDescInput" placeholder="محتوى المنشور أو وصف التصميم..."></textarea>
                    <input type="text" id="postImgInput" placeholder="رابط الصورة (URL)...">
                    <button onclick="addNewPost()" class="ctrl-btn" data-i18n="btnAdd">نشر الآن</button>
                </div>
                
                <div class="ctrl-box">
                    <h3 data-i18n="ctrlSettings">إعدادات الموقع والتخصيص</h3>
                    <label data-i18n="labelTitle">تغيير اسم الموقع الرئيسي:</label>
                    <input type="text" id="siteTitleInput" placeholder="اكتب اسم الموقع الجديد...">
                    <button onclick="updateSiteTitle()" class="ctrl-btn" data-i18n="btnSaveTitle">حفظ الاسم</button>
                    
                    <label style="margin-top: 15px; display:block;" data-i18n="labelBg">تغيير لون/خلفية الموقع:</label>
                    <input type="color" id="bgColorPicker" value="#030712" onchange="changeBgColor(this.value)">
                </div>
            </div>
        </div>
    </section>

    <!-- قسم التواصل (Contact) -->
    <section id="contact" class="contact-section">
        <h2 data-i18n="contactTitle">تواصل مع مؤسس "عالم ثاني"</h2>
        <div class="contact-cards">
            <a href="mailto:abowd773a@gmail.com" class="contact-card">
                <span>📧</span>
                <h3>البريد الإلكتروني</h3>
                <p>abowd773a@gmail.com</p>
            </a>
            <a href="https://wa.me/967773546637" target="_blank" class="contact-card">
                <span>💬</span>
                <h3>واتساب المباشر</h3>
                <p>+967 773 546 637</p>
            </a>
            <a href="https://pin.it/6uFYoGdKw" target="_blank" class="contact-card">
                <span>📌</span>
                <h3>معرض بنترست</h3>
                <p>Pinterest Portfolio</p>
            </a>
        </div>
    </section>

    <!-- التذييل -->
    <footer>
        <p>© 2026 <span id="footerBrand">عالم ثاني 2026 (Second World)</span>. جميع الحقوق محفوظة.</p>
    </footer>

    <!-- ==========================================
       ملف البرمجيات المدمج (JavaScript)
       ================================---------- -->
    <script>
        const translations = {
            ar: {
                pageTitle: "عالم ثاني 2026 | Second World",
                navHome: "الرئيسية",
                navPosts: "المنشورات",
                navControl: "لوحة التحكم",
                navContact: "تواصل معنا",
                navStart: "ابدأ الآن",
                heroBadge: "إصدار 2026 - مستقبل الابتكار الرقمي",
                heroDesc: "بوابة نحو فضاءات افتراضية وتقنيات ذكية تتخطى حدود الخيال المألوف.",
                btnExplore: "استكشف المنشورات",
                btnPin: "معرض Pinterest",
                postsTitle: "أحدث المنشورات والإبداعات",
                postsSub: "محتوى متجدد، تصاميم، ورؤى مستقبلية",
                ctrlTitle: "🎛️ لوحة التحكم السريعة",
                ctrlSub: "أضف منشوراتك، عدّل اسم الموقع، أو غير خلفية الموقع بلمسة واحدة!",
                ctrlAddPost: "إضافة منشور / تصميم جديد",
                btnAdd: "نشر الآن",
                ctrlSettings: "إعدادات الموقع والتخصيص",
                labelTitle: "تغيير اسم الموقع الرئيسي:",
                btnSaveTitle: "حفظ الاسم",
                labelBg: "تغيير لون/خلفية الموقع:",
                contactTitle: 'تواصل مع مؤسس "عالم ثاني"'
            },
            en: {
                pageTitle: "Second World 2026 | Digital Portal",
                navHome: "Home",
                navPosts: "Posts",
                navControl: "Control Panel",
                navContact: "Contact Us",
                navStart: "Get Started",
                heroBadge: "2026 Edition - Future of Digital Innovation",
                heroDesc: "A gateway to virtual spaces and smart technologies beyond imagination.",
                btnExplore: "Explore Posts",
                btnPin: "Pinterest Portfolio",
                postsTitle: "Latest Posts & Creations",
                postsSub: "Dynamic content, designs, and future visions",
                ctrlTitle: "🎛️ Quick Control Panel",
                ctrlSub: "Add posts, update the site name, or change the background instantly!",
                ctrlAddPost: "Add New Post / Design",
                btnAdd: "Publish Now",
                ctrlSettings: "Site Settings & Customization",
                labelTitle: "Change Main Site Title:",
                btnSaveTitle: "Save Title",
                labelBg: "Change Site Background:",
                contactTitle: "Contact the Founder of 'Second World'"
            }
        };

        let currentLang = 'ar';

        function toggleLanguage() {
            currentLang = currentLang === 'ar' ? 'en' : 'ar';
            const htmlRoot = document.getElementById('htmlRoot');
            const langLabel = document.getElementById('langLabel');
            
            htmlRoot.setAttribute('dir', currentLang === 'ar' ? 'rtl' : 'ltr');
            htmlRoot.setAttribute('lang', currentLang);
            langLabel.innerText = currentLang === 'ar' ? 'EN' : 'AR';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[currentLang][key]) {
                    el.innerText = translations[currentLang][key];
                }
            });
        }

        function addNewPost() {
            const title = document.getElementById('postTitleInput').value.trim();
            const desc = document.getElementById('postDescInput').value.trim();
            const img = document.getElementById('postImgInput').value.trim() || "https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?q=80&w=800&auto=format&fit=crop";
            
            if(!title || !desc) {
                alert(currentLang === 'ar' ? 'الرجاء إدخال العنوان والمحتوى على الأقل!' : 'Please enter title and description!');
                return;
            }

            const postsGrid = document.getElementById('postsGrid');
            const dateStr = new Date().toISOString().split('T')[0];

            const postCard = document.createElement('div');
            postCard.className = 'post-card';
            postCard.innerHTML = `
                <img src="${img}" alt="Post Image">
                <div class="post-content">
                    <span class="post-date">${dateStr}</span>
                    <h3>${title}</h3>
                    <p>${desc}</p>
                </div>
            `;

            postsGrid.prepend(postCard);

            document.getElementById('postTitleInput').value = '';
            document.getElementById('postDescInput').value = '';
            document.getElementById('postImgInput').value = '';
            
            alert(currentLang === 'ar' ? 'تم نشر المنشور بنجاح!' : 'Post published successfully!');
        }

        function updateSiteTitle() {
            const newTitle = document.getElementById('siteTitleInput').value.trim();
            if(!newTitle) return;

            document.getElementById('mainTitle').innerText = newTitle;
            document.getElementById('logoText').innerText = newTitle;
            document.getElementById('footerBrand').innerText = newTitle + " (Second World)";
            
            document.getElementById('siteTitleInput').value = '';
            alert(currentLang === 'ar' ? 'تم تحديث اسم الموقع بنجاح!' : 'Site title updated successfully!');
        }

        function changeBgColor(color) {
            document.getElementById('bodyBg').style.backgroundColor = color;
        }
    </script>
</body>
</html>
